{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sign Bridge",
  "version": "1.0.0",
  "identifier": "com.signbridge.desktop",
  "build": {
    "beforeDevCommand": "node ./scripts/ensure-web-server.mjs",
    "devUrl": "http://127.0.0.1:8000",
    "beforeBuildCommand": "",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Sign Bridge",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "maximized": false,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": true,
        "url": "http://127.0.0.1:8000/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
